[user]
	name = Cristian Manoliu
	email = cristian.manoliu@gmail.com
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = simple
[rebase]
	autoStash = true
	autosquash = true
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[diff]
	colorMoved = default
	algorithm = histogram
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
